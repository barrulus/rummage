# fish completion for rummage.
complete -c rummage -l new-window -d 'Open a separate browser window'
complete -c rummage -f
complete -c rummage -n 'not __fish_contains_opt reveal properties' -a '(__fish_complete_directories)'
complete -c rummage -n '__fish_contains_opt reveal properties' -F
complete -c rummage -s h -l help -d 'Show usage'
complete -c rummage -l config -r -F -d 'Read configuration from a file'
complete -c rummage -l check-config -d 'Check configuration and exit'
complete -c rummage -l test-scene -d 'Show the renderer test scene'
complete -c rummage -l version -d 'Print the version'
complete -c rummage -l about -d 'Print diagnostic information'
complete -c rummage -l reveal -d 'Select paths in their folders'
complete -c rummage -l properties -d 'Show properties of paths'
complete -c rummage -l open-folders -d 'Open folders in tabs'
complete -c rummage -l portal -d 'Run the file chooser portal backend'
complete -c rummage -l file-manager1 -d 'Run the Show in Folder service'
complete -c rummage -l set-file-manager -d 'Register as the file manager'
complete -c rummage -l unset-file-manager -d 'Remove file manager registration'
complete -c rummage -l pick -d 'Choose files'
complete -c rummage -l pick-directory -d 'Choose a folder'
complete -c rummage -l save-file -d 'Choose a file to save'
set -l picker '__fish_contains_opt pick pick-directory save-file'
complete -c rummage -n $picker -l multiple -d 'Choose multiple files'
complete -c rummage -n $picker -l name -x -d 'Proposed filename'
complete -c rummage -n $picker -l title -x -d 'Window title'
