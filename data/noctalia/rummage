# rummage colors, generated by Noctalia from the rummage template. Do not edit: Noctalia
# rewrites this file on every theme change, and rummage reloads it.
mode = "{{ mode }}"

[colors]
<* for name, value in colors *>
{{ name }} = "{{ value.default.hex }}"
<* endfor *>

# The git integration's file states. Unset, rummage makes them from this palette (editor hues,
# readable on it). To take them from the theme instead, uncomment and adjust, for example:
# git_added = "{{ colors.tertiary.default.hex }}"
# git_modified = "{{ colors.secondary.default.hex }}"
# git_deleted = "{{ colors.error.default.hex }}"
# git_renamed = "{{ colors.primary.default.hex }}"
# git_untracked = "{{ colors.tertiary.default.hex }}"
# git_conflict = "{{ colors.error_container.default.hex }}"
# git_ignored = "{{ colors.outline.default.hex }}"
