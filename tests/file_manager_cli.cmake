# CLI coverage without a compositor or access to the user's session/configuration.
file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
set(ENV{XDG_CONFIG_HOME} "${TEST_DIRECTORY}/config")
set(ENV{XDG_DATA_HOME} "${TEST_DIRECTORY}/data")
set(ENV{XDG_STATE_HOME} "${TEST_DIRECTORY}/state")
set(ENV{DBUS_SESSION_BUS_ADDRESS} "unix:path=${TEST_DIRECTORY}/no-session-bus")

function(expect_status expected)
    execute_process(COMMAND "${RUMMAGE_EXECUTABLE}" ${ARGN}
        WORKING_DIRECTORY "${TEST_DIRECTORY}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${status}: ${output}${error}")
    endif()
endfunction()

expect_status(2 --reveal)
expect_status(2 --open-folders)
expect_status(2 --properties --pick)
expect_status(2 --reveal --portal)
expect_status(2 --file-manager1 --portal)
expect_status(2 --set-file-manager --pick)
expect_status(2 --set-file-manager --unset-file-manager)
expect_status(1 --reveal -- missing-relative-item)
expect_status(1 --properties -- -missing-item)
expect_status(1 --open-folders -- missing-folder)
file(WRITE "${TEST_DIRECTORY}/regular-file" "data")
expect_status(1 --open-folders -- regular-file)
if(EXISTS "${TEST_DIRECTORY}/config")
    message(FATAL_ERROR "Rejected requests should not create UI configuration")
endif()

expect_status(0 --set-file-manager)
set(service "${TEST_DIRECTORY}/data/dbus-1/services/org.freedesktop.FileManager1.service")
if(NOT EXISTS "${service}")
    message(FATAL_ERROR "Setup did not create the user-local service")
endif()
file(READ "${service}" contents)
if(NOT contents MATCHES "Name=org.freedesktop.FileManager1" OR
   NOT contents MATCHES "--file-manager1")
    message(FATAL_ERROR "Setup created a malformed service: ${contents}")
endif()
expect_status(0 --unset-file-manager)
if(EXISTS "${service}")
    message(FATAL_ERROR "Unset left rummage's service in place")
endif()
file(WRITE "${service}" "[D-BUS Service]\nExec=/foreign/manager\n")
expect_status(1 --set-file-manager)
expect_status(0 --unset-file-manager)
file(READ "${service}" contents)
if(NOT contents STREQUAL "[D-BUS Service]\nExec=/foreign/manager\n")
    message(FATAL_ERROR "A foreign service was modified")
endif()
file(REMOVE_RECURSE "${TEST_DIRECTORY}")
