#!/usr/bin/make -f
%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DRUMMAGE_FONT=ON -DRUMMAGE_PHOTOS=ON -DRUMMAGE_MEDIA=ON -DRUMMAGE_PDF=ON -DRUMMAGE_PRIVATE_PDFIUM=ON -DBUILD_SHARED_LIBS=OFF -DRUMMAGE_BUILD_TESTS=OFF -DRUMMAGE_WERROR=OFF

# Build only the installed application and helper, not developer benchmarks.
override_dh_auto_build:
	dh_auto_build -- rummage rummage-preview rummage-media rummage-pdf rummage-playback rummage-audio rummage-font rummage_photos

override_dh_auto_test:
	# The complete unit suite runs in the separate Nix CI job.

# PDFium is private to the helper, not a public system library.
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/rummage/usr/libexec/rummage
